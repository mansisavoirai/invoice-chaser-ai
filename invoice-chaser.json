      "parameters": {
        "jsCode": "const items = $input.all(); const now = new Date($now.setZone('Asia/Kolkata').toISO()); return items.map((item, index) => { const newJson = {}; for (const key in item.json) { const value = item.json[key]; newJson[key.trim()] = typeof value === 'string' ? value.trim() : value; } newJson['Client Name'] = newJson['Client Name'] || 'Valued Client'; newJson['Invoice Amount'] = Number(newJson['Invoice Amount']) || 0; newJson['Formatted Amount'] = newJson['Currency'] + ' ' + newJson['Invoice Amount'].toLocaleString('en-IN'); return { json: newJson, pairedItem: index }; }).filter(item => item.json['Status'] !== 'Paid').filter(item => item.json['Client Email'] && item.json['Client Email'].includes('@')).filter(item => { const lastContacted = item.json['Last Contacted']; if (!lastContacted) return true; const lastDate = new Date(lastContacted); const hoursSince = (now - lastDate) / (1000 * 60 * 60); return hoursSince >= 48; });"
